  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist/server",
    "sourceMap": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/server/**/*.ts",
    "src/showdown/**/*.ts"
  ]
}
